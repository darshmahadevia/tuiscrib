{
  "name": "tuiscrib",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:service",
    "dev:service": "bun run --cwd packages/service dev",
    "dev:terminal": "bun run --cwd packages/terminal dev",
    "service:migrate": "bun run --cwd packages/service migrate",
    "service:start": "bun run --cwd packages/service start",
    "build:release": "bun run --cwd packages/terminal build",
    "smoke:release": "bun run --cwd packages/terminal smoke",
    "smoke:hosted": "bun scripts/hosted-smoke.ts",
    "smoke:container": "bun scripts/container-smoke.ts",
    "db:migrate": "bun run --cwd packages/persistence migrate",
    "test": "bun test",
    "test:acceptance": "bun test packages/acceptance/src",
    "typecheck": "bun run --cwd packages/contracts typecheck && bun run --cwd packages/persistence typecheck && bun run --cwd packages/service typecheck && bun run --cwd packages/terminal typecheck && bun run --cwd packages/acceptance typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "bun-types": "1.3.14",
    "typescript": "^5.8.3"
  }
}
