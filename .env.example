# Local development uses an unpooled disposable PostgreSQL endpoint.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tuiscrib
# Hosted runtime uses a pooled TLS endpoint. Hosted migrations use a direct TLS endpoint when reachable,
# or a session-pooled endpoint on port 5432. Never use transaction pooling on port 6543 for migrations.
# MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tuiscrib
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_POOL_MAX=4
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
MIGRATION_LOCK_TIMEOUT_MS=30000
MIGRATION_LOCK_POLL_MS=100
WEBSOCKET_IDLE_TIMEOUT_SECONDS=120
TUISCRIB_MIGRATIONS_PREDEPLOYED=false
# TUISCRIB_REQUIRE_POOLED_DATABASE_URL=true
TUISCRIB_URL=http://127.0.0.1:3000
TUISCRIB_CLIENT=local
